# ============================================================================
# Этап 3. Стартовый скрипт: VFS и все команды предыдущих этапов.
#
# Запуск: emu --vfs vfs/demo.csv --script scripts/stage3.emu
# ============================================================================

# --- 1. Справка и разбор аргументов ----------------------------------------
help
ls "/etc"
ls '/home/user/docs'

# --- 2. Обход дерева: четыре уровня вложенности ----------------------------
ls /
cd /home
ls
cd user
ls
cd docs
ls
cd ../..
ls
cd /
ls /var
ls /var/log
ls /tmp

# --- 3. Файл и каталог как аргумент ls -------------------------------------
ls /etc/passwd
ls ./etc/../etc/motd

# --- 4. Обработка ошибок ----------------------------------------------------
# Несуществующий путь.
ls /нет-такого
# Путь проходит через файл.
ls /etc/passwd/внутри
# cd в файл и в несуществующий каталог.
cd /etc/passwd
cd /нет-такого
cd /etc/motd
# Ошибка разбора строки: незакрытая кавычка.
ls "незакрытая кавычка
# Неизвестная команда.
unknown_command --flag
# Неверный код завершения.
exit abc

# --- 5. Штатное завершение --------------------------------------------------
exit 0

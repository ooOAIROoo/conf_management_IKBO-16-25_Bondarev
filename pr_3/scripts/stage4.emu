# ============================================================================
# Этап 4. Стартовый скрипт: основные команды во всех режимах.
#
# Запуск: emu --vfs vfs/demo.csv --script scripts/stage4.emu
# ============================================================================

help

# --- 1. ls: режимы и обработка ошибок --------------------------------------
ls
ls /
ls -l /
ls -la /etc
ls -a /
ls -l /etc/passwd
ls /etc /tmp
ls -- /etc
# Неизвестная опция.
ls -z
# Несуществующий путь.
ls /нет-такого
# Частичная ошибка: выводится существующий каталог, код возврата 1.
ls -l /нет-такого /etc

# --- 2. cd: все режимы ------------------------------------------------------
cd /home/user
cd
cd ~
cd /var/log
ls
cd ..
ls
# Возврат в предыдущий каталог.
cd -
# Ошибки: файл вместо каталога, несуществующий путь, лишние аргументы.
cd /etc/passwd
cd /нет-такого
cd /etc /tmp

# --- 3. tree ---------------------------------------------------------------
cd /
tree
tree /home
tree /var/log
tree /etc/passwd
tree /нет-такого

# --- 4. who -----------------------------------------------------------------
who
who лишний-аргумент

# --- 5. uname ---------------------------------------------------------------
uname
uname -s
uname -n
uname -a
uname -sn
uname -z

# --- 6. Общие ошибки --------------------------------------------------------
ls "незакрытая кавычка
unknown_command
exit abc

# --- 7. Штатное завершение --------------------------------------------------
exit 0

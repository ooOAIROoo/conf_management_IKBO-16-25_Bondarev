# ============================================================================
# Этап 2. Стартовый скрипт эмулятора.
#
# Строки, начинающиеся с '#', — комментарии: эмулятор их не выполняет.
# Пустые строки также игнорируются.
# ============================================================================

# --- 1. Команды-заглушки этапа 1 -------------------------------------------
ls /
ls -l "файл с пробелами" 'ещё один аргумент'
cd "/home/user dir"
cd
cd 'каталог с пробелом'

# --- 2. Экранирование вне кавычек и кавычки внутри кавычек -----------------
ls a\ b "c\"d"

# --- 3. Комментарий в конце строки -----------------------------------------
ls / # это комментарий, в аргументы не попадёт

# --- 4. Обработка ошибок: незакрытая кавычка -------------------------------
# Скрипт не останавливается, ошибка выводится с номером строки.
ls "незакрытая кавычка

# --- 5. Обработка ошибок: неизвестная команда ------------------------------
unknown_command --flag

# --- 6. Обработка ошибок: неверный код выхода ------------------------------
exit abc

# --- 7. Штатное завершение --------------------------------------------------
exit 0

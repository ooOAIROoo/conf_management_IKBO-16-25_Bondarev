# ============================================================================
# Этап 5. Стартовый скрипт: команды touch и rmdir.
#
# Все изменения выполняются только в оперативной памяти: CSV-файл VFS и
# физический диск не изменяются.
# Запуск: emu --vfs vfs/demo.csv --script scripts/stage5.emu
# ============================================================================

help

# --- 1. Исходное состояние --------------------------------------------------
ls -la /home/user
tree /tmp

# --- 2. touch: создание файлов ---------------------------------------------
touch /home/user/new.txt
touch "/tmp/файл с пробелом.txt"
touch /home/user/docs/a.txt /home/user/docs/b.txt
ls -l /home/user
ls -l /home/user/docs
# Повторный touch существующего файла — успешная операция.
touch /home/user/new.txt

# --- 3. touch: обработка ошибок --------------------------------------------
# Родительский каталог не существует.
touch /нет-такого/файл.txt
# Родитель — файл, а не каталог.
touch /etc/passwd/внутри
# Нет операндов.
touch
# Недопустимая опция.
touch -z /tmp/x

# --- 4. rmdir: удаление пустого каталога -----------------------------------
ls -la /tmp
rmdir /tmp/empty
ls -la /tmp

# --- 5. rmdir: обработка ошибок --------------------------------------------
# Непустой каталог.
rmdir /home/user/docs
# Файл вместо каталога.
rmdir /etc/passwd
# Несуществующий путь.
rmdir /нет-такого
# Корневой каталог.
rmdir /
# Нет операндов.
rmdir
# Смешанный случай: /tmp/empty уже удалён, а /tmp непуст.
rmdir /tmp/empty /tmp

# --- 6. Итоговое состояние --------------------------------------------------
tree /
ls -la /home/user/docs

# --- 7. Общие ошибки --------------------------------------------------------
rmdir "незакрытая кавычка
unknown_command
exit abc

# --- 8. Штатное завершение --------------------------------------------------
exit 0
